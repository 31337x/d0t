// Inspired by Catnap (https://github.com/iinsertNameHere/catnap)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "none"
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#90} user    {#keys}│",
            "type": "title",
            "format": "{user-name}@{host-name}",
            "outputColor": "90"
        },
        {
            "key": "│ {#37}󰅐 uptime  {#keys}│",
            "type": "uptime",
            "outputColor": "37"
        },
        {
            "key": "│ {#36}{icon} distro  {#keys}│",
            "type": "os",
            "format": "{name} {version-id}",
            "outputColor": "36"
        },
        {
            "key": "│ {#35} kernel  {#keys}│",
            "type": "command",
            "text": "printf 'Linux %s' \"$(uname -r | cut -d- -f1)\"",
            "outputColor": "35"
        },
        {
            "key": "│ {#34}󰇄 desktop {#keys}│",
            "type": "de",
            "outputColor": "34"
        },
        {
            "key": "│ {#34} term    {#keys}│",
            "type": "terminal",
            "outputColor": "34"
        },
        {
            "key": "│ {#33}󰖯 wm      {#keys}│",
            "type": "command",
            "text": "umbriel --version",
            "outputColor": "33"
        },
        {
            "key": "│ {#32}󰏖 pkg     {#keys}│",
            "type": "packages",
            "outputColor": "32"
        },
        {
            "key": "│ {#31} shell   {#keys}│",
            "type": "shell",
            "outputColor": "31"
        },
        {
            "key": "│ {#90}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "format": "{name}",
            "outputColor": "90"
        },
        {
            "key": "│ {#37}󰢮 gpu     {#keys}│",
            "type": "gpu",
            "format": "{name}",
            "outputColor": "37"
        },
        {
            "key": "│ {#36}󰉉 disk    {#keys}│",
            "type": "disk",
            "folders": "/",
            "format": "{size-used} / {size-total}",
            "outputColor": "36"
        },
        {
            "key": "│ {#35} memory  {#keys}│",
            "type": "memory",
            "format": "{used} / {total}",
            "outputColor": "35"
        },
        {
            "key": "│ {#34}󰩟 network {#keys}│",
            "type": "localip",
            "showPrefixLen": false,
            "format": "{ipv4}",
            "outputColor": "34"
        },
        {
            "key": "│ {#33}󰩠 public  {#keys}│",
            "type": "publicip",
            "format": "{ip}",
            "outputColor": "33"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
