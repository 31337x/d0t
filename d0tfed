Install Fedora Minimal

sudoedit /etc/dnf/dnf.conf
[main]
install_weak_deps=False
max_parallel_downloads=20
fastestmirror=True

sudo dnf install -y "https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm"

sudo dnf install -y "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm"

sudo dnf install -y --nogpgcheck --repofrompath 'terra,https://repos.fyralabs.com/terra$releasever' terra-release

sudo dnf upgrade --refresh

sudo dnf install iwlwifi-mvm-firmware plymouth-theme-spinner google-noto-sans-arabic-vf-fonts google-noto-naskh-arabic-vf-fonts google-noto-color-emoji-fonts google-noto-sans-symbols-vf-fonts google-noto-sans-math-fonts tuned tuned-ppd noctalia noctalia-greeter greetd umbriel-nightly kitty yazi helix helix-parsers gnome-keyring-pam zen-browser mpv imv btop freerdp openfortivpn git-core tar bat fzf zoxide starship fastfetch xdg-user-dirs adw-gtk3-theme cursor upower yt-dlp pipewire-pulseaudio pipewire-alsa

sudo dnf swap ffmpeg-free ffmpeg --allowerasing

sudoedit /etc/default/grub
GRUB_TIMEOUT=2
GRUB_TIMEOUT_STYLE=hidden

sudoedit /etc/greetd/config.toml
command = "/usr/bin/noctalia-greeter-session"

sudo grub2-mkconfig -o /boot/grub2/grub.cfg

sudo plymouth-set-default-theme -R spinner

sudo install -d -o greetd -g "$(id -gn greetd)" -m 0750 /var/lib/noctalia-greeter

sudo env GREETER_USER=greetd noctalia-greeter-apply-appearance --setup-system

sudo systemctl enable --now tuned tuned-ppd

sudo systemctl enable greetd.service

sudo systemctl set-default graphical.target

sudo systemctl enable --now upower

sudoedit /var/lib/noctalia-greeter/greeter.toml
[appearance]
hide_logo = true

systemctl --user daemon-reload

systemctl --user enable --now pipewire-pulse.socket

systemctl --user restart pipewire wireplumber pipewire-pulse

xdg-user-dirs-update

fc-cache -f

sudo setcap cap_perfmon=+ep "$(readlink -f "$(command -v btop)")"

curl -fsSL https://chatgpt.com/codex/install.sh | sh

sudo mkdir -p /mnt/usb
sudo mount /dev/sda1 /mnt/usb/
cp -r /mnt/usb/Pictures/ /home/r00t/Pictures/
cp -r /mnt/usb/.local/ /home/r00t/.local/
cp -r /mnt/usb/.config/ /home/r00t/.config/
cp /mnt/usb/d0t/.bashrc /home/r00t/

sudo dnf install ./termius-app-10.2.1-1.fc44.x86_64.rpm

sudo dnf autoremove

reboot and enjoy
